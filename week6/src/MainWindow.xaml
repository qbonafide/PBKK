<Window x:Class="StudentRegistration.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Student Registration"
        Height="760"
        Width="1250"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="25">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= FORM ================= -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,10,0">

                <TextBlock Text="STUDENT REGISTRATION"
                           FontSize="22"
                           FontWeight="Bold"
                           Margin="0,0,0,20"/>

                <TextBlock Text="NIM"/>
                <TextBox x:Name="txtNim"
                         Height="30"
                         MaxLength="12"
                         PreviewTextInput="Angka_PreviewTextInput"
                         Margin="0,5,0,12"/>

                <TextBlock Text="Nama Mahasiswa"/>
                <TextBox x:Name="txtNama"
                         Height="30"
                         MaxLength="100"
                         Margin="0,5,0,12"/>

                <TextBlock Text="Program Studi"/>
                <ComboBox x:Name="cmbProdi"
                          Height="30"
                          DisplayMemberPath="ProgramName"
                          SelectedValuePath="ProgramId"
                          Margin="0,5,0,12"/>

                <TextBlock Text="Tanggal Lahir"/>
                <DatePicker x:Name="dtpLahir"
                            Height="30"
                            Margin="0,5,0,12"/>

                <TextBlock Text="Alamat"/>
                <TextBox x:Name="txtAlamat"
                         Height="60"
                         MaxLength="250"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         Margin="0,5,0,12"/>

                <TextBlock Text="No. Telepon"/>
                <TextBox x:Name="txtTelepon"
                         Height="30"
                         MaxLength="15"
                         PreviewTextInput="Angka_PreviewTextInput"
                         Margin="0,5,0,18"/>

                <StackPanel Orientation="Horizontal">
                    <Button Content="Simpan"
                            Width="95"
                            Height="38"
                            Margin="0,0,10,0"
                            Click="BtnSimpan_Click"/>
                    <Button x:Name="btnUpdate"
                            Content="Update"
                            Width="95"
                            Height="38"
                            Margin="0,0,10,0"
                            IsEnabled="False"
                            Click="BtnUpdate_Click"/>
                    <Button Content="Reset"
                            Width="95"
                            Height="38"
                            Click="BtnReset_Click"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!-- ================= DATA ================= -->
        <Grid Grid.Column="2">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="DATA MAHASISWA"
                       FontSize="22"
                       FontWeight="Bold"
                       Margin="0,0,0,20"/>

            <StackPanel Grid.Row="1" Margin="0,0,0,10">
                <TextBlock Text="Cari (NIM / Nama / Program Studi)"/>
                <TextBox x:Name="txtSearch"
                         Height="30"
                         Margin="0,5,0,0"
                         TextChanged="TxtSearch_TextChanged"/>
            </StackPanel>

            <DataGrid x:Name="StudentDataGrid"
                      Grid.Row="2"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      SelectionChanged="StudentDataGrid_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID"
                                        Binding="{Binding StudentId}"
                                        Width="50"/>
                    <DataGridTextColumn Header="NIM"
                                        Binding="{Binding NIM}"
                                        Width="90"/>
                    <DataGridTextColumn Header="Nama"
                                        Binding="{Binding Name}"
                                        Width="140"/>
                    <DataGridTextColumn Header="Program Studi"
                                        Binding="{Binding ProgramName}"
                                        Width="150"/>
                    <DataGridTextColumn Header="Tanggal Lahir"
                                        Binding="{Binding BirthDate, StringFormat=dd/MM/yyyy}"
                                        Width="95"/>
                    <DataGridTextColumn Header="Alamat"
                                        Binding="{Binding Address}"
                                        Width="*"/>
                    <DataGridTextColumn Header="No. Telepon"
                                        Binding="{Binding PhoneNumber}"
                                        Width="110"/>
                    <DataGridTextColumn Header="Dibuat"
                                        Binding="{Binding CreatedAt, StringFormat=dd/MM/yyyy HH:mm}"
                                        Width="120"/>
                </DataGrid.Columns>
            </DataGrid>

            <DockPanel Grid.Row="3" Margin="0,10,0,0" LastChildFill="False">
                <TextBlock x:Name="lblJumlah"
                           Text="Jumlah Mahasiswa: 0"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           DockPanel.Dock="Left"/>
                <Button Content="Hapus"
                        Width="100"
                        Height="38"
                        DockPanel.Dock="Right"
                        Click="BtnHapus_Click"/>
                <Button Content="Refresh"
                        Width="100"
                        Height="38"
                        Margin="0,0,10,0"
                        DockPanel.Dock="Right"
                        Click="RefreshButton_Click"/>
            </DockPanel>

        </Grid>

    </Grid>

</Window>